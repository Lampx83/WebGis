# ── Database (PostGIS service in the stack) ───────────────────────────────
# These configure the bundled Postgres container AND the connection string the
# web app uses. Change the password before deploying to anything public.
POSTGRES_USER=webgis
POSTGRES_PASSWORD=webgis
POSTGRES_DB=webgis

# Host port the WebGIS app is published on (container always listens on 3000).
WEB_PORT=8043

# ── Auth ──────────────────────────────────────────────────────────────────
# BẮT BUỘC ở production: chuỗi ngẫu nhiên >= 32 ký tự, dùng để ký phiên đăng nhập (JWT).
# Thiếu / quá ngắn / còn giá trị mẫu → ứng dụng từ chối khởi động.
# Tạo nhanh: openssl rand -base64 48
AUTH_SECRET=
# Tài khoản quản trị mặc định (seed bởi scripts/02-users-schema.sql): admin / Admin@123
# → hệ thống BẮT BUỘC đổi mật khẩu ở lần đăng nhập đầu tiên.

# Khóa cho thiết bị/gateway IoT gửi dữ liệu (POST readings, detections, logging, alerts)
# mà không có phiên đăng nhập. Gửi kèm header:  x-api-key: <giá trị>  (hoặc Authorization: Bearer ...)
# Để trống = tắt; tối thiểu 16 ký tự. Tạo nhanh: openssl rand -hex 24
INGEST_API_KEY=

# Chỉ dùng cho demo: cho phép dữ liệu mẫu + tài khoản admin giả khi chạy production KHÔNG có DATABASE_URL.
# DEMO_MODE=true

# ── Tác vụ nền (chạy trong tiến trình web, an toàn khi chạy nhiều bản nhờ advisory lock) ──
# Thiết bị im lặng quá số phút này → chuyển "offline" và tạo cảnh báo mất kết nối.
DEVICE_OFFLINE_MINUTES=15
# Pin dưới mức này (%) → tạo cảnh báo pin yếu.
LOW_BATTERY_PERCENT=20
# Chu kỳ kiểm tra sức khỏe thiết bị (giây).
# HEALTH_CHECK_INTERVAL_SECONDS=60
# TỰ ĐỘNG xóa dữ liệu quá hạn (thô > 30 ngày, tổng hợp giờ > 1 năm) tối đa 1 lần/24h. Mặc định TẮT.
AUTO_RETENTION_CLEANUP=false
# Tắt toàn bộ tác vụ nền (ví dụ khi chạy nhiều replica và chỉ muốn một bản chạy job).
# DISABLE_JOBS=true

# ── Cảnh báo qua Zalo (tuỳ chọn) ──────────────────────────────────────────
# Access token của Zalo Official Account. Để trống = bỏ qua gửi Zalo (no-op).
ZALO_ACCESS_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────
# Set automatically by docker-compose to point at the `db` service.
# Override only if you use an EXTERNAL database instead of the bundled one.
# For a managed provider with TLS, append ?sslmode=require
# DATABASE_URL=postgres://webgis:webgis@db:5432/webgis

# Max connections in the app's DB pool (per container).
# DATABASE_POOL_MAX=10
