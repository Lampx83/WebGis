# ── Database (PostGIS service in the stack) ───────────────────────────────
# These configure the bundled Postgres container AND the connection string the
# web app uses. Change the password before deploying to anything public.
POSTGRES_USER=webgis
POSTGRES_PASSWORD=webgis
POSTGRES_DB=webgis

# Host port the WebGIS app is published on (container always listens on 3000).
WEB_PORT=8043

# ── App ───────────────────────────────────────────────────────────────────
# Set automatically by docker-compose to point at the `db` service.
# Override only if you use an EXTERNAL database instead of the bundled one.
# For a managed provider with TLS, append ?sslmode=require
# DATABASE_URL=postgres://webgis:webgis@db:5432/webgis

# Max connections in the app's DB pool (per container).
# DATABASE_POOL_MAX=10
